          "level": "warning",
          "message": {
            "text": "The same exported credential reference appears in: Email Responder Agent, RD-Calendar Agent. The report intentionally omits its raw name and ID."
          }
        },
        {
          "ruleId": "MW-003-21",
          "level": "warning",
          "message": {
            "text": "The same exported credential reference appears in: RD-Calendar Agent, RD-Notion Agent. The report intentionally omits its raw name and ID."
          }
        },
        {
          "ruleId": "MW-003-25",
          "level": "warning",
          "message": {
            "text": "The same exported credential reference appears in: BlueSky Post, Email Responder Agent, URL Status Workflow. The report intentionally omits its raw name and ID."
          }
        },
        {
          "ruleId": "MW-003-37",
          "level": "warning",
          "message": {
            "text": "The same exported credential reference appears in: Social Media Manager AI Agent, Social Media Manager Telegram Trigger. The report intentionally omits its raw name and ID."
          }
        },
        {
          "ruleId": "MW-003-41",
          "level": "warning",
          "message": {
            "text": "The same exported credential reference appears in: Social Media Manager AI Agent, Social Media Manager Telegram Trigger. The report intentionally omits its raw name and ID."
          }
        },
        {
          "ruleId": "MW-004-01",
          "level": "warning",
          "message": {
            "text": "Email Responder Agent / Calendar Agent refers to a workflow that is not uniquely present in this export set."
          }
        },
        {
          "ruleId": "MW-004-02",
          "level": "warning",
          "message": {
            "text": "Parent Agent / Notion Agent refers to a workflow that is not uniquely present in this export set."
          }
        },
        {
          "ruleId": "MW-004-03",
          "level": "warning",
          "message": {
            "text": "Parent Agent / Calendar Agent refers to a workflow that is not uniquely present in this export set."
          }
        }
      ]
    }
  ]
}

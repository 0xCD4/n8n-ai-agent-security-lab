{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csintresearch.org/schemas/n8n-security-contract-v1.json",
  "title": "n8n AI Security Regression Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "target",
    "gate",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedPathPrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/.+"
          },
          "uniqueItems": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failOnStaticSeverity",
        "requireRuntime"
      ],
      "properties": {
        "failOnStaticSeverity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "off"
          ]
        },
        "requireRuntime": {
          "const": true
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "request",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        },
        "observe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "expect"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            },
            "expect": {
              "$ref": "#/$defs/expectation"
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "json": {}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          ]
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "bodyIncludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bodyExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "json": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requiredPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbiddenPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "equals": {
              "type": "object"
            },
            "allowedTopLevelKeys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
